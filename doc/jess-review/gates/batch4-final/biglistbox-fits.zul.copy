<?page title="Biglistbox fits" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Biglistbox (fits both ways)"/></div>
    <zscript>
        import zk.example.FakerMatrixModel;
        FakerMatrixModel fitsModel = new FakerMatrixModel(2, 3);
    </zscript>
    <biglistbox id="fitsBiglist" model="${fitsModel}" hflex="1" height="200px" colWidth="130px">
        <template name="heads">
            <html><![CDATA[<div>${each[matrixInfo[0]]}</div>]]></html>
        </template>
        <template name="rows">
            <html><![CDATA[<div>${each[matrixInfo[0]]}</div>]]></html>
        </template>
    </biglistbox>
</div>
</zk>
